# Requerido -- el backend no arranca sin esto (Fase 2: siempre PostgreSQL).
# Usa el driver psycopg3 explicito: postgresql+psycopg://...
DATABASE_URL=postgresql+psycopg://usuario:password@host:5432/tejido?sslmode=require

HOST=127.0.0.1
PORT=8765

# "development" o "production" -- production oculta /docs, /redoc, /openapi.json.
ENVIRONMENT=development
LOG_LEVEL=INFO

MAX_BODY_BYTES=1000000
REQUEST_TIMEOUT_SECONDS=30

# Correo de invitaciones (Resend, https://resend.com). Sin API key el envio falla
# pero la cuenta se crea igual y el admin recibe el link para compartirlo a mano.
# En modo sandbox (sin dominio verificado) Resend solo entrega al correo de la cuenta.
RESEND_API_KEY=
EMAIL_FROM=TEJIDO <notificaciones@tejido.co>
# Base de los links de invitacion: {FRONTEND_BASE_URL}/#invitacion/{token}
FRONTEND_BASE_URL=http://localhost:5173
