# Requerido -- el backend no arranca sin esto (Fase 2: siempre PostgreSQL).
# Usa el driver psycopg3 explicito: postgresql+psycopg://...
DATABASE_URL=postgresql+psycopg://usuario:password@host:5432/tejido?sslmode=require

HOST=127.0.0.1
PORT=8765

# "development" o "production" -- production oculta /docs, /redoc, /openapi.json.
ENVIRONMENT=development
LOG_LEVEL=INFO

MAX_BODY_BYTES=1000000
REQUEST_TIMEOUT_SECONDS=30
